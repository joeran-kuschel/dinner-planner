# Local development database (docker compose service "db").
# `npm run db:up` creates .env from this file with a random password instead of `change-me`;
# if you copy it by hand, choose your own password and use the same one in both lines.
# Kubernetes has its own credentials: `npm run k8s:deploy` creates the dinner-planner-db Secret.
POSTGRES_PASSWORD="change-me"
DATABASE_URL="postgresql://dinner:change-me@localhost:5433/dinner_planner?schema=public"

# Optional, to try the access gate with `npm run dev` (lib/access.ts): at least 16 characters. Without it the app is
# open in development; in the cluster the key is a Secret that deploy.sh makes (npm run k8s:access-link prints the link).
# ACCESS_KEY="a-long-random-string"
